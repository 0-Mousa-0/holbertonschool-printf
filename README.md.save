## o---octal 

 ```c
int print_octal(unsigned int n)
{
    int count = 0;

    if (n / 8)
        count += print_octal(n / 8);

    count += write(1, (char[]){'0' + (n % 8)}, 1);

    return count;
}

/* CASE FOR _printf */
case 'o':
    count += print_octal(va_arg(args, unsigned int));
    break;

